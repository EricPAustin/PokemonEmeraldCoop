--- src/load_save.c
+++ src/load_save.c
@@ -1,4 +1,5 @@
 #include "global.h"
+#include "coop_link.h"
 #include "malloc.h"
 #include "berry_powder.h"
 #include "item.h"
@@ -182,7 +183,14 @@ void SaveObjectEvents(void)
     int i;
 
     for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
         gSaveBlock1Ptr->objectEvents[i] = gObjectEvents[i];
+        // Linked co-op: Player 2's character isn't part of the save, and the
+        // off-screen flag depends on which GBA's screen it's drawn on.
+        gSaveBlock1Ptr->objectEvents[i].offScreen = FALSE;
+        if (CoopP2_IsObjectP2(&gObjectEvents[i]))
+            gSaveBlock1Ptr->objectEvents[i].active = FALSE;
+    }
 }
 
 void LoadObjectEvents(void)
