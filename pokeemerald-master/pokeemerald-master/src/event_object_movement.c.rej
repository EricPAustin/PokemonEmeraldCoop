--- src/event_object_movement.c
+++ src/event_object_movement.c
@@ -1,4 +1,5 @@
 #include "global.h"
+#include "coop_link.h"
 #include "malloc.h"
 #include "battle_pyramid.h"
 #include "berry.h"
@@ -1654,6 +1655,17 @@ void TrySpawnObjectEvents(s16 cameraX, s16 cameraY)
         s16 top = gSaveBlock1Ptr->pos.y;
         s16 bottom = gSaveBlock1Ptr->pos.y + MAP_OFFSET_H + 2;
 
+        // Linked co-op: also spawn objects around Player 2.
+        if (COOP_LINKED && gCoopLinkActive)
+        {
+            s16 left2, right2, top2, bottom2;
+            CoopP2_GetViewBounds(&left2, &right2, &top2, &bottom2);
+            left = min(left, left2);
+            right = max(right, right2);
+            top = min(top, top2);
+            bottom = max(bottom, bottom2);
+        }
+
         if (CurrentBattlePyramidLocation() != PYRAMID_LOCATION_NONE)
             objectCount = GetNumBattlePyramidObjectEvents();
         else if (InTrainerHill())
@@ -1703,6 +1715,19 @@ static void RemoveObjectEventIfOutsideView(struct ObjectEvent *objectEvent)
     s16 top =    gSaveBlock1Ptr->pos.y;
     s16 bottom = gSaveBlock1Ptr->pos.y + 16;
 
+    // Linked co-op: keep Player 2 and everything around Player 2.
+    if (COOP_LINKED && gCoopLinkActive)
+    {
+        s16 left2, right2, top2, bottom2;
+        if (CoopP2_IsObjectP2(objectEvent))
+            return;
+        CoopP2_GetViewBounds(&left2, &right2, &top2, &bottom2);
+        left = min(left, left2);
+        right = max(right, right2);
+        top = min(top, top2);
+        bottom = max(bottom, bottom2);
+    }
+
     if (objectEvent->currentCoords.x >= left && objectEvent->currentCoords.x <= right
      && objectEvent->currentCoords.y >= top && objectEvent->currentCoords.y <= bottom)
         return;
@@ -1776,7 +1801,7 @@ static void SpawnObjectEventOnReturnToField(u8 objectEventId, s16 x, s16 y)
         sprite->x += 8;
         sprite->y += 16 + sprite->centerToCornerVecY;
         sprite->images = graphicsInfo->images;
-        if (objectEvent->movementType == MOVEMENT_TYPE_PLAYER)
+        if (objectEvent->movementType == MOVEMENT_TYPE_PLAYER && !CoopP2_IsObjectP2(objectEvent)) // Linked co-op: Player 2 is not the player avatar
         {
             SetPlayerAvatarObjectEventIdAndObjectId(objectEventId, i);
             objectEvent->warpArrowSpriteId = CreateWarpArrowSprite();
@@ -1788,7 +1813,7 @@ static void SpawnObjectEventOnReturnToField(u8 objectEventId, s16 x, s16 y)
         sprite->coordOffsetEnabled = TRUE;
         sprite->sObjEventId = objectEventId;
         objectEvent->spriteId = i;
-        if (!objectEvent->inanimate && objectEvent->movementType != MOVEMENT_TYPE_PLAYER)
+        if (!objectEvent->inanimate && (objectEvent->movementType != MOVEMENT_TYPE_PLAYER || CoopP2_IsObjectP2(objectEvent)))
             StartSpriteAnim(sprite, GetFaceDirectionAnimNum(objectEvent->facingDirection));
 
         ResetObjectEventFldEffData(objectEvent);
@@ -2368,7 +2393,14 @@ void SetObjectEventDirection(struct ObjectEvent *objectEvent, u8 direction)
 
 static const u8 *GetObjectEventScriptPointerByLocalIdAndMap(u8 localId, u8 mapNum, u8 mapGroup)
 {
-    return GetObjectEventTemplateByLocalIdAndMap(localId, mapNum, mapGroup)->script;
+    const struct ObjectEventTemplate *obj = GetObjectEventTemplateByLocalIdAndMap(localId, mapNum, mapGroup);
+
+    // Objects without a template (like Player 2 in linked co-op) have no script.
+    // The original game would read from address 0, which gives different
+    // results on each GBA.
+    if (obj == NULL)
+        return NULL;
+    return obj->script;
 }
 
 const u8 *GetObjectEventScriptPointerByObjectEventId(u8 objectEventId)
@@ -2379,11 +2411,10 @@ const u8 *GetObjectEventScriptPointerByObjectEventId(u8 objectEventId)
 static u16 GetObjectEventFlagIdByLocalIdAndMap(u8 localId, u8 mapNum, u8 mapGroup)
 {
     const struct ObjectEventTemplate *obj = GetObjectEventTemplateByLocalIdAndMap(localId, mapNum, mapGroup);
-#ifdef UBFIX
     // BUG: The function may return NULL, and attempting to read from NULL may freeze the game using modern compilers.
+    // (Always checked: linked co-op needs this to read the same value on both GBAs.)
     if (obj == NULL)
         return 0;
-#endif // UBFIX
     return obj->flagId;
 }
 
