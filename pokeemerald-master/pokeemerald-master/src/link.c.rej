--- src/link.c
+++ src/link.c
@@ -1,4 +1,5 @@
 #include "global.h"
+#include "coop_link.h"
 #include "m4a.h"
 #include "malloc.h"
 #include "reload_save.h"
@@ -236,6 +237,11 @@ static const u8 sUnusedData[] = {0x00, 0xFF, 0xFE, 0xFF, 0x00};
 
 bool8 IsWirelessAdapterConnected(void)
 {
+#if COOP_LINKED
+    // Linked co-op uses the cable; the wireless features are off.
+    if (gCoopLinkActive)
+        return FALSE;
+#endif
     SetWirelessCommType1();
     InitRFUAPI();
     if (rfu_LMAN_REQBN_softReset_and_checkID() == RFU_ID)
@@ -368,6 +374,13 @@ void OpenLink(void)
 {
     int i;
 
+#if COOP_LINKED
+    // Linked co-op keeps its own link open. Features that would reopen it
+    // (union room, cable club, record mixing...) must not reset it.
+    if (gCoopLinkActive)
+        return;
+#endif
+
     if (!gWirelessCommType)
     {
         ResetSerial();
@@ -399,6 +412,10 @@ void OpenLink(void)
 
 void CloseLink(void)
 {
+#if COOP_LINKED
+    if (gCoopLinkActive)
+        return;
+#endif
     gReceivedRemoteLinkPlayers = FALSE;
     if (gWirelessCommType)
         LinkRfu_Shutdown();
@@ -1808,8 +1825,40 @@ bool8 HandleLinkConnection(void)
     return FALSE;
 }
 
+// Linked co-op: the session starts by reloading the save, which clears EWRAM
+// (including sLinkOpen). Keeps the open link working afterwards.
+void CoopLink_RestoreLinkOpen(void)
+{
+    sLinkOpen = TRUE;
+}
+
+bool8 CoopLink_IsLinkOpen(void)
+{
+    return sLinkOpen;
+}
+
+// Linked co-op: takes the next received packet, if any (the normal link code
+// only hands over one per frame).
+bool8 CoopLink_DequeueRecvPacket(u16 (*recvCmds)[CMD_LENGTH])
+{
+    if (gLink.recvQueue.count == 0)
+        return FALSE;
+    DequeueRecvCmds(recvCmds);
+    return TRUE;
+}
+
+// Linked co-op: queues a packet to be sent at the next screen refresh.
+void CoopLink_SendPacket(u16 *sendCmd)
+{
+    EnqueueSendCmd(sendCmd);
+}
+
 void SetWirelessCommType1(void)
 {
+#if COOP_LINKED
+    if (gCoopLinkActive)
+        return;
+#endif
     if (gReceivedRemoteLinkPlayers == 0)
         gWirelessCommType = 1;
 }
