--- src/fieldmap.c
+++ src/fieldmap.c
@@ -563,6 +563,57 @@ s32 GetPostCameraMoveMapBorderId(s32 x, s32 y)
     return GetMapBorderIdAt(gSaveBlock1Ptr->pos.x + MAP_OFFSET + x, gSaveBlock1Ptr->pos.y + MAP_OFFSET + y);
 }
 
+// Linked co-op: Player 2's screen can show more of the neighbouring maps than
+// the loaded area (which only holds MAP_OFFSET tiles of each connected map).
+// Reads those tiles straight from the connected map. Only used for drawing.
+u32 MapGridGetMetatileIdAtForDrawing(s32 x, s32 y)
+{
+    s32 i, count, cx, cy, width, height;
+    const struct MapConnection *connection;
+
+    if (AreCoordsWithinMapGridBounds(x, y) || gMapHeader.connections == NULL)
+        return MapGridGetMetatileIdAt(x, y);
+
+    width = gMapHeader.mapLayout->width;
+    height = gMapHeader.mapLayout->height;
+    count = gMapHeader.connections->count;
+    connection = gMapHeader.connections->connections;
+    for (i = 0; i < count; i++, connection++)
+    {
+        const struct MapHeader *cMap = GetMapHeaderFromConnection(connection);
+        s32 cWidth, cHeight;
+
+        if (cMap == NULL)
+            continue;
+        cWidth = cMap->mapLayout->width;
+        cHeight = cMap->mapLayout->height;
+        switch (connection->direction)
+        {
+        case CONNECTION_SOUTH:
+            cx = x - (connection->offset + MAP_OFFSET);
+            cy = y - (height + MAP_OFFSET);
+            break;
+        case CONNECTION_NORTH:
+            cx = x - (connection->offset + MAP_OFFSET);
+            cy = y - (MAP_OFFSET - cHeight);
+            break;
+        case CONNECTION_WEST:
+            cx = x - (MAP_OFFSET - cWidth);
+            cy = y - (connection->offset + MAP_OFFSET);
+            break;
+        case CONNECTION_EAST:
+            cx = x - (width + MAP_OFFSET);
+            cy = y - (connection->offset + MAP_OFFSET);
+            break;
+        default:
+            continue;
+        }
+        if (cx >= 0 && cx < cWidth && cy >= 0 && cy < cHeight)
+            return UNPACK_METATILE(cMap->mapLayout->map[cx + cWidth * cy]);
+    }
+    return MapGridGetMetatileIdAt(x, y);
+}
+
 bool32 CanCameraMoveInDirection(s32 direction)
 {
     s32 x, y;
