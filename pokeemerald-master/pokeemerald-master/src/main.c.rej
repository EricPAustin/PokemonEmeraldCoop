--- src/main.c
+++ src/main.c
@@ -1,4 +1,5 @@
 #include "global.h"
+#include "coop_link.h"
 #include "crt0.h"
 #include "malloc.h"
 #include "link.h"
@@ -162,8 +163,11 @@ void AgbMain(void)
             }
         }
 
-        PlayTimeCounter_Update();
-        MapMusicMain();
+        if (!gCoopLinkActive || CoopLink_TickRanThisFrame())
+        {
+            PlayTimeCounter_Update();
+            MapMusicMain();
+        }
         WaitForVBlank();
     }
 }
@@ -171,7 +175,22 @@ void AgbMain(void)
 static void UpdateLinkAndCallCallbacks(void)
 {
     if (!HandleLinkConnection())
+    {
+#if COOP_LINKED
+        // Linked co-op: only simulate a frame once both players' buttons arrived.
+        if (gCoopLinkActive)
+        {
+            if (CoopLink_BeginTick())
+            {
+                CallCallbacks();
+                if (gCoopLinkActive)
+                    CoopLink_EndTick();
+            }
+            return;
+        }
+#endif
         CallCallbacks();
+    }
 }
 
 static void InitMainCallbacks(void)
@@ -344,25 +363,31 @@ static void VBlankIntr(void)
     else if (gLinkVSyncDisabled == FALSE)
         LinkVSync();
 
-    gMain.vblankCounter1++;
+    // In linked co-op these advance once per simulated frame instead (see CoopLink_BeginTick).
+    if (!gCoopLinkActive)
+    {
+        gMain.vblankCounter1++;
 
-    if (gTrainerHillVBlankCounter && *gTrainerHillVBlankCounter < 0xFFFFFFFF)
-        (*gTrainerHillVBlankCounter)++;
+        if (gTrainerHillVBlankCounter && *gTrainerHillVBlankCounter < 0xFFFFFFFF)
+            (*gTrainerHillVBlankCounter)++;
+    }
 
     if (gMain.vblankCallback)
         gMain.vblankCallback();
 
-    gMain.vblankCounter2++;
+    if (!gCoopLinkActive)
+        gMain.vblankCounter2++;
 
     CopyBufferedValuesToGpuRegs();
     ProcessDma3Requests();
 
     gPcmDmaCounter = gSoundInfo.pcmDmaCounter;
 
-    m4aSoundMain();
+    if (!gCoopLinkActive || CoopLink_ShouldStepSound())
+        m4aSoundMain();
     TryReceiveLinkBattleData();
 
-    if (!gMain.inBattle || !(gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_FRONTIER | BATTLE_TYPE_RECORDED)))
+    if (!gCoopLinkActive && (!gMain.inBattle || !(gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_FRONTIER | BATTLE_TYPE_RECORDED))))
         Random();
 
     UpdateWirelessStatusIndicatorSprite();
