+void ProcessDma3Requests(void)
+{
+    if (sDma3ManagerLocked)
+        return;
+    DoDma3Requests(TRUE);
+}
+
+// Linked co-op: finishes every queued copy right away. Otherwise how many
+// screen refreshes a copy takes depends on timing, and code that waits for
+// copies to finish would run differently on the two GBAs.
+void FlushDma3Requests(void)
+{
+    if (sDma3ManagerLocked)
+        return;
+    sDma3ManagerLocked = TRUE; // Keeps the VBlank interrupt from processing them at the same time
+    DoDma3Requests(FALSE);
+    sDma3ManagerLocked = FALSE;
+}
