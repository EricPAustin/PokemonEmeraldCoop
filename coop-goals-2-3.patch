+// Linked co-op: Player 2 pressed A while facing (x, y). Same as Player 1
+// talking to someone, reading a sign or using a PC there (but no surfing).
+bool8 Coop_TryStartInteractionAt(s16 x, s16 y, u8 elevation, u8 direction)
+{
+    struct MapPosition position;
+    u8 metatileBehavior = MapGridGetMetatileBehaviorAt(x, y);
+    const u8 *script;
+
+    position.x = x;
+    position.y = y;
+    position.elevation = elevation;
+    script = GetInteractedObjectEventScript(&position, metatileBehavior, direction);
+    if (script == NULL)
+        script = GetInteractedBackgroundEventScript(&position, metatileBehavior, direction);
+    if (script == NULL)
+        script = GetInteractedMetatileScript(&position, metatileBehavior, direction);
+    if (script == NULL)
+        return FALSE;
+    if (script != EventScript_PC)
+        PlaySE(SE_SELECT);
+    ScriptContext_SetupScript(script);
+    return TRUE;
+}
