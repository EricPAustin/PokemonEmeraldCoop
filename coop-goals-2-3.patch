+// Player 2 pressed A: talk to whoever / use whatever is in front of them.
+static bool8 TryP2Interaction(struct ObjectEvent *p2)
+{
+    s16 x = p2->currentCoords.x;
+    s16 y = p2->currentCoords.y;
+    u8 dir = p2->facingDirection;
+
+    MoveCoords(dir, &x, &y);
