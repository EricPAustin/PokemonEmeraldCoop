+// ---------------------------------------------------------------------------
+// Lockstep
+// ---------------------------------------------------------------------------
+
+// Keeps other link callbacks from taking over. Packets are sent by SendKeys.
+static void LinkCB_CoopSendKeys(void)
+{
+}
+
+// Sends this GBA's buttons for one future frame.
+static void SendKeys(u16 keys)
+{
+    u16 cmd[CMD_LENGTH] = {0};
+
+    cmd[0] = LINKCMD_COOP_KEYS;
+    cmd[1] = keys;
+    cmd[2] = sCoop.sendHashTick;
+    cmd[3] = sCoop.sendHash & 0xFFFF;
+    cmd[4] = sCoop.sendHash >> 16;
+    CoopLink_SendPacket(cmd);
+    sCoop.packetsSent++;
+}
+
+// Files a received packet's buttons under each player. Both GBAs receive the
+// same packets, so both build the same lists.
+static bool8 ReceivePacket(u16 (*recv)[CMD_LENGTH])
+{
+    s32 i;
+
+    for (i = 0; i < COOP_NUM_PLAYERS; i++)
+    {
+        if (recv[i][0] != LINKCMD_COOP_KEYS)
+            continue;
+        if (sCoop.keyFifoCount[i] >= KEY_FIFO_SIZE)
+            return FALSE;
+        sCoop.keyFifo[i][(sCoop.keyFifoHead[i] + sCoop.keyFifoCount[i]) % KEY_FIFO_SIZE] = recv[i][1] & KEYS_MASK;
+        sCoop.keyFifoCount[i]++;
+        if (i != GetMultiplayerId())
+            CheckRemoteHash(recv[i][2], recv[i][3] | (recv[i][4] << 16));
+    }
+    return TRUE;
+}
+
+static u16 PopKeys(u8 player)
+{
+    u16 keys = sCoop.keyFifo[player][sCoop.keyFifoHead[player]];
+    sCoop.keyFifoHead[player] = (sCoop.keyFifoHead[player] + 1) % KEY_FIFO_SIZE;
+    sCoop.keyFifoCount[player]--;
+    return keys;
+}
+
+static bool8 IsFreeRoam(void)
+{
+    return gMain.callback2 == CB2_Overworld
+        && gMain.callback1 == CB1_Overworld
+        && !ArePlayerFieldControlsLocked();
+}
+
+static void ApplyVirtualKeys(u16 held)
+{
+    held &= KEYS_MASK;
+    gMain.newKeysRaw = held & ~sCoop.virtualPrevHeld;
+    gMain.newKeys = gMain.newKeysRaw;
+    gMain.newAndRepeatedKeys = gMain.newKeysRaw;
+    if (held != 0 && held == sCoop.virtualPrevHeld)
+    {
+        if (--sCoop.virtualRepeat == 0)
+        {
+            gMain.newAndRepeatedKeys = held;
+            sCoop.virtualRepeat = gKeyRepeatContinueDelay;
+        }
+    }
+    else
+    {
+        sCoop.virtualRepeat = gKeyRepeatStartDelay;
+    }
+    gMain.keyRepeatCounter = sCoop.virtualRepeat;
+    gMain.heldKeysRaw = held;
+    gMain.heldKeys = held;
+    if (gSaveBlock2Ptr->optionsButtonMode == OPTIONS_BUTTON_MODE_L_EQUALS_A)
+    {
+        if (JOY_NEW(L_BUTTON))
+            gMain.newKeys |= A_BUTTON;
+        if (JOY_HELD(L_BUTTON))
+            gMain.heldKeys |= A_BUTTON;
+    }
+    if (JOY_NEW(gMain.watchedKeysMask))
+        gMain.watchedKeysPressed = TRUE;
+    sCoop.virtualPrevHeld = held;
+}
+
+// Decides whose buttons drive the game this frame. Both GBAs compute the same
+// answer, since it only depends on the shared game state and both players' keys.
+//
+// - Walking around: Player 1's buttons move the main character (Player 2's
+//   character is moved by coop_player2.c). Player 2 can open the START menu,
+//   and then controls it until it closes.
+// - Battle choices (FIGHT/BAG/POKéMON/RUN, moves, targets, switching): the
+//   player who owns that Pokémon.
+// - Text (battle messages, dialogue boxes): either player can press A or B.
+// - Everything else: the last player in control (usually Player 1).
+static void UpdateVirtualInput(void)
+{
+    u16 new1 = sCoop.playerKeys[COOP_PLAYER_1] & ~sCoop.prevPlayerKeys[COOP_PLAYER_1];
+    u16 new2 = sCoop.playerKeys[COOP_PLAYER_2] & ~sCoop.prevPlayerKeys[COOP_PLAYER_2];
+    bool8 shared;
+
+    if (!gMain.inBattle)
+        sCoop.inBattlePrompt = FALSE;
+
+    if (IsFreeRoam())
+    {
+        gCoopInputOwner = COOP_PLAYER_1;
+        if ((new2 & START_BUTTON) && !(new1 & (START_BUTTON | SELECT_BUTTON | A_BUTTON)))
+        {
+            gCoopInputOwner = COOP_PLAYER_2;
+            ApplyVirtualKeys(START_BUTTON);
+            return;
+        }
+        ApplyVirtualKeys(sCoop.playerKeys[COOP_PLAYER_1]);
+        return;
+    }
+
+    if (gMain.inBattle)
+        shared = !sCoop.inBattlePrompt && gMain.callback2 == BattleMainCB2;
+    else
+        shared = gMain.callback2 == CB2_Overworld && !IsFieldMessageBoxHidden();
+
+    if (shared)
+        ApplyVirtualKeys(sCoop.playerKeys[gCoopInputOwner] | (sCoop.playerKeys[gCoopInputOwner ^ 1] & (A_BUTTON | B_BUTTON)));
+    else
+        ApplyVirtualKeys(sCoop.playerKeys[gCoopInputOwner]);
+}
+
+static void CheckRemoteHash(u16 tick, u32 hash)
+{
+    s32 i;
+
+    if (gCoopDesyncTick != 0 || tick == 0)
+        return;
+    for (i = 0; i < HASH_HISTORY; i++)
+    {
+        if (sCoop.hashTicks[i] == tick)
+        {
+            if (sCoop.hashValues[i] != hash)
+            {
+                gCoopDesyncTick = gCoopTick;
+#if COOP_DEBUG_DESYNC
+                gCoopDebugFreezeTick = tick + 64;
+#endif
+            }
+            return;
+        }
+    }
+}
+
+bool8 CoopLink_BeginTick(void)
+{
+    u16 recv[MAX_LINK_PLAYERS][CMD_LENGTH];
+    u16 localKeys = gMain.heldKeysRaw; // This GBA's real buttons, read this frame
+    s32 i;
+
+    sCoop.tickRan = FALSE;
+    if (gLinkErrorOccurred)
+    {
+        // The link broke. Leave lockstep so the link error screen can run.
+        gCoopLinkActive = FALSE;
+        return TRUE;
+    }
+    if (!CoopLink_IsLinkOpen() || !(gLinkStatus & LINK_STAT_CONN_ESTABLISHED))
+    {
+        ShowCoopErrorScreen(sText_LinkLost);
+        return TRUE;
+    }
+    gLinkCallback = LinkCB_CoopSendKeys; // Nothing else may take over the link
+
+    // Collect everything that arrived since last frame.
+    if (!(gLinkStatus & LINK_STAT_RECEIVED_NOTHING) && !ReceivePacket(gRecvCmds))
+    {
+        ShowCoopErrorScreen(sText_LinkLost);
+        return TRUE;
+    }
+    while (CoopLink_DequeueRecvPacket(recv))
+    {
+        if (!ReceivePacket(recv))
+        {
+            ShowCoopErrorScreen(sText_LinkLost);
+            return TRUE;
+        }
+    }
+
+    // Simulate a frame once both players' buttons for it are here. Otherwise
+    // wait (the other GBA is behind, e.g. still loading a map).
+#if COOP_DEBUG_DESYNC
+    if (gCoopDebugFreezeTick != 0 && gCoopTick >= gCoopDebugFreezeTick)
+        return FALSE; // Both games stop at the same frame so their memory can be compared
+#endif
+    if (sCoop.keyFifoCount[COOP_PLAYER_1] != 0 && sCoop.keyFifoCount[COOP_PLAYER_2] != 0)
+    {
+        // Graphics copies queued last frame are done by now on both GBAs.
+        FlushDma3Requests();
+        for (i = 0; i < COOP_NUM_PLAYERS; i++)
+        {
+            sCoop.prevPlayerKeys[i] = sCoop.playerKeys[i];
+            sCoop.playerKeys[i] = PopKeys(i);
+        }
+        UpdateVirtualInput();
+
+        // Things the original game advances once per screen refresh now advance
+        // once per simulated frame, so both games see the same values.
+        gMain.vblankCounter1++;
+        gMain.vblankCounter2++;
+        if (gTrainerHillVBlankCounter && *gTrainerHillVBlankCounter < 0xFFFFFFFF)
+            (*gTrainerHillVBlankCounter)++;
+        Random();
+        gCoopTick++;
+        sCoop.tickRan = TRUE;
+    }
+
+    // Stay INPUT_DELAY frames ahead: one packet per simulated frame.
+    if (sCoop.packetsSent < gCoopTick + INPUT_DELAY)
+        SendKeys(localKeys);
+
+    return sCoop.tickRan;
+}
+
+static u32 HashBytes(u32 hash, const void *data, u32 size)
+{
+    const u8 *bytes = data;
+    u32 i;
+
+    for (i = 0; i < size; i++)
+        hash = (hash ^ bytes[i]) * 16777619u;
+    return hash;
+}
+
+static u32 HashU32(u32 hash, u32 value)
+{
+    return HashBytes(hash, &value, sizeof(value));
+}
+
+// Hash of the game state that must be identical on both GBAs.
+static u32 ComputeStateHash(void)
+{
+    u32 hash = 2166136261u;
+    s32 i;
+
+    hash = HashU32(hash, gRngValue);
+    hash = HashU32(hash, (u32)gMain.callback1);
+    hash = HashU32(hash, (u32)gMain.callback2);
+    hash = HashBytes(hash, &gSaveBlock1Ptr->location, sizeof(gSaveBlock1Ptr->location));
+    hash = HashBytes(hash, &gSaveBlock1Ptr->pos, sizeof(gSaveBlock1Ptr->pos));
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        struct ObjectEvent *obj = &gObjectEvents[i];
+        if (!obj->active)
+            continue;
+        hash = HashU32(hash, i | (obj->localId << 8) | (obj->graphicsId << 16) | (obj->facingDirection << 24));
+        hash = HashBytes(hash, &obj->currentCoords, sizeof(obj->currentCoords));
+    }
+    hash = HashBytes(hash, gPlayerParty, sizeof(gPlayerParty));
+    if (gMain.inBattle)
+        hash = HashBytes(hash, gBattleMons, sizeof(gBattleMons));
+    return hash;
+}
+
+
+#if COOP_DEBUG_DESYNC
+// Desync debugging (see COOP_DEBUG_DESYNC): a hash of each part of the game
+// state for the last 128 frames. Compare gCoopDebugHistory between the two
+// GBAs after both stop at gCoopDebugFreezeTick to see what diverged first.
+EWRAM_DATA u32 gCoopDebugHistory[128][8] = {0};
+u32 CoopDebug_GetScriptInfo(void); // script.c
+
+static void RecordDebugHistory(void)
+{
+    u32 *h = gCoopDebugHistory[gCoopTick % 128];
+    u32 x;
+    s32 i;
+
+    h[0] = gCoopTick;
+    h[1] = gRngValue;
+    h[2] = (u32)gMain.callback2;
+    x = 2166136261u;
+    for (i = 0; i < NUM_TASKS; i++)
+        x = HashU32(x, gTasks[i].isActive ? (u32)gTasks[i].func : 0);
+    h[3] = x;
+    x = 2166136261u;
+    for (i = 0; i < NUM_TASKS; i++)
+    {
+        if (gTasks[i].isActive)
+            x = HashBytes(x, gTasks[i].data, sizeof(gTasks[i].data));
+    }
+    h[4] = x;
+    x = 2166136261u;
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+        x = HashBytes(x, &gObjectEvents[i].currentCoords, sizeof(gObjectEvents[i].currentCoords));
+    h[5] = x;
+    h[6] = HashBytes(2166136261u, gPlayerParty, sizeof(gPlayerParty));
+    h[7] = CoopDebug_GetScriptInfo();
+}
+#endif
+
+void CoopLink_EndTick(void)
+{
+#if COOP_DEBUG_DESYNC
+    RecordDebugHistory();
+#endif
+    sCoop.ticksEnded++;
+    if (gCoopTick % HASH_INTERVAL == 0)
+    {
+        u32 hash = ComputeStateHash();
+        sCoop.hashTicks[sCoop.hashPos] = gCoopTick & 0xFFFF;
+        sCoop.hashValues[sCoop.hashPos] = hash;
+        sCoop.hashPos = (sCoop.hashPos + 1) % HASH_HISTORY;
+        sCoop.sendHashTick = gCoopTick & 0xFFFF;
+        sCoop.sendHash = hash;
+    }
+    if (gCoopDesyncTick != 0 && !sCoop.errorShown && !COOP_DEBUG_DESYNC)
+    {
+        sCoop.errorShown = TRUE;
+        ShowCoopErrorScreen(sText_Desync);
+    }
+}
+
+// A cable club feature tried to start its own link session (see CreateLinkupTask).
+void CoopLink_RefuseLinkup(void)
+{
+    gLinkType = LINKTYPE_COOP;
+    gSpecialVar_Result = LINKUP_FAILED;
+    ScriptContext_Enable();
+}
+
+bool8 CoopLink_TickRanThisFrame(void)
+{
+    return sCoop.tickRan;
+}
+
+// The sound engine advances exactly once between simulated frames, so scripts
+// that wait for a sound effect or music to finish behave the same on both GBAs.
+bool8 CoopLink_ShouldStepSound(void)
+{
+    if (sCoop.soundSteps < sCoop.ticksEnded)
+    {
+        sCoop.soundSteps = sCoop.ticksEnded;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+u16 CoopLink_GetPlayerKeys(u8 player)
+{
+    return sCoop.playerKeys[player];
+}
+
+u16 CoopLink_GetPlayerNewKeys(u8 player)
+{
+    return sCoop.playerKeys[player] & ~sCoop.prevPlayerKeys[player];
+}
+
+void CoopLink_EndBattlePrompt(void)
+{
+    sCoop.inBattlePrompt = FALSE;
+}
+
+void CoopLink_SetInputOwnerForBattler(u8 battler)
+{
+    if (!gCoopLinkActive)
+        return;
+    sCoop.inBattlePrompt = TRUE;
+    if (GetBattlerSide(battler) != B_SIDE_PLAYER)
+        return;
+    gCoopInputOwner = GetMonCoopOwner(&gPlayerParty[gBattlerPartyIndexes[battler]]);
+}
+
+// ---------------------------------------------------------------------------
+// Shared clock: Player 1's clock at link-up, advanced by simulated frames.
+// ---------------------------------------------------------------------------
+
+static u8 ToBcd(u32 value)
+{
+    return ((value / 10) << 4) | (value % 10);
+}
+
+static u8 DaysInMonth(u32 year, u32 month)
+{
+    static const u8 sDays[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+
+    if (month == 2 && IsLeapYear(year))
+        return 29;
+    return sDays[month - 1];
+}
+
+bool8 CoopLink_GetRtcInfo(struct SiiRtcInfo *rtc)
+{
+    u32 seconds, days;
+    u32 year, month, day;
+
+    if (!gCoopLinkActive)
+        return FALSE;
+
+    *rtc = sCoop.baseRtc;
+    seconds = ConvertBcdToBinary(sCoop.baseRtc.hour) * 3600
+            + ConvertBcdToBinary(sCoop.baseRtc.minute) * 60
+            + ConvertBcdToBinary(sCoop.baseRtc.second)
+            + gCoopTick / 60;
+    days = seconds / 86400;
+    seconds %= 86400;
+    rtc->hour = ToBcd(seconds / 3600);
+    rtc->minute = ToBcd((seconds / 60) % 60);
+    rtc->second = ToBcd(seconds % 60);
+
+    if (days != 0)
+    {
+        year = ConvertBcdToBinary(sCoop.baseRtc.year);
+        month = ConvertBcdToBinary(sCoop.baseRtc.month);
+        day = ConvertBcdToBinary(sCoop.baseRtc.day);
+        rtc->dayOfWeek = (sCoop.baseRtc.dayOfWeek + days) % 7;
+        if (month < 1 || month > 12)
+            month = 1;
+        while (days != 0)
+        {
+            days--;
+            if (++day > DaysInMonth(year, month))
+            {
+                day = 1;
+                if (++month > 12)
+                {
+                    month = 1;
+                    year = (year + 1) % 100;
+                }
+            }
+        }
+        rtc->year = ToBcd(year);
+        rtc->month = ToBcd(month);
+        rtc->day = ToBcd(day);
+    }
+    return TRUE;
+}
diff --git a/src/coop_player2.c b/src/coop_player2.c
new file mode 100644
index 000000000..38ac6f531
--- /dev/null
+++ b/src/coop_player2.c
@@ -0,0 +1,455 @@
+#include "global.h"
+#include "coop.h"
+#include "coop_link.h"
+#include "event_data.h"
+#include "event_object_movement.h"
+#include "field_camera.h"
+#include "field_player_avatar.h"
+#include "fieldmap.h"
+#include "metatile_behavior.h"
+#include "script.h"
+#include "constants/songs.h"
+#include "overworld.h"
+#include "task.h"
+#include "sound.h"
+#include "field_screen_effect.h"
+#include "field_door.h"
+#include "constants/event_object_movement.h"
+#include "constants/event_objects.h"
+#include "constants/flags.h"
+
+// Linked co-op: Player 2's character in the overworld.
+//
+// Player 1 is the game's normal player character: it triggers doors, scripts,
+// wild encounters and trainers. Player 2 is an extra object event that walks
+// around with Player 2's buttons, within COOP_TETHER_X/Y tiles of Player 1.
+// While Player 1 surfs, bikes or dives, and right after map changes, Player 2
+// "rides along" (hidden on Player 1's tile) and hops off next to Player 1 as
+// soon as Player 1 is standing still on foot.
+//
+// Everything here runs inside the shared simulated frame and only reads state
+// that is identical on both GBAs, so both games move Player 2 the same way.
+
+#define abs(x) ((x) < 0 ? -(x) : (x))
+
+static struct ObjectEvent *GetPlayer1(void)
+{
+    return &gObjectEvents[gPlayerAvatar.objectEventId];
+}
+
+struct ObjectEvent *CoopP2_GetObject(void)
+{
+    s32 i;
+
+    if (!gCoopLinkActive)
+        return NULL;
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        if (gObjectEvents[i].active && gObjectEvents[i].localId == LOCALID_COOP_PLAYER2)
+            return &gObjectEvents[i];
+    }
+    return NULL;
+}
+
+bool8 CoopP2_IsObjectP2(const struct ObjectEvent *objectEvent)
+{
+    return gCoopLinkActive && objectEvent->localId == LOCALID_COOP_PLAYER2;
+}
+
+// TRUE while Player 2 walks around on their own (visible, not riding along).
+bool8 CoopP2_IsWalking(void)
+{
+    struct ObjectEvent *p2 = CoopP2_GetObject();
+    return p2 != NULL && !p2->invisible;
+}
+
+static bool8 MustRideAlong(void)
+{
+    return (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER
+                                 | PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE)) != 0;
+}
+
+static bool8 IsWithinTether(s16 x, s16 y, s16 otherX, s16 otherY)
+{
+    return abs(x - otherX) <= COOP_TETHER_X && abs(y - otherY) <= COOP_TETHER_Y;
+}
+
+// Called before Player 1 walks onto (x, y).
+bool8 CoopP2_IsPlayer1MoveAllowed(s16 x, s16 y)
+{
+    struct ObjectEvent *p2 = CoopP2_GetObject();
+
+    if (p2 == NULL || p2->invisible)
+        return TRUE;
+    return IsWithinTether(x, y, p2->currentCoords.x, p2->currentCoords.y);
+}
+
+// The area around Player 2 where map objects should exist, in the same format
+// as the vanilla area around the camera (see TrySpawnObjectEvents).
+void CoopP2_GetViewBounds(s16 *left, s16 *right, s16 *top, s16 *bottom)
+{
+    struct ObjectEvent *p2 = CoopP2_GetObject();
+    s16 x, y;
+
+    if (p2 == NULL || p2->invisible)
+    {
+        x = gSaveBlock1Ptr->pos.x;
+        y = gSaveBlock1Ptr->pos.y;
+    }
+    else
+    {
+        x = p2->currentCoords.x - MAP_OFFSET;
+        y = p2->currentCoords.y - MAP_OFFSET;
+    }
+    *left = x - 2;
+    *right = x + MAP_OFFSET_W + 2;
+    *top = y;
+    *bottom = y + MAP_OFFSET_H + 2;
+}
+
+static bool8 IsAnyObjectAt(const struct ObjectEvent *self, s16 x, s16 y)
+{
+    s32 i;
+
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        const struct ObjectEvent *obj = &gObjectEvents[i];
+        if (!obj->active || obj == self)
+            continue;
+        if ((obj->currentCoords.x == x && obj->currentCoords.y == y)
+         || (obj->previousCoords.x == x && obj->previousCoords.y == y))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// Can Player 2 be placed on this tile when hopping off next to Player 1?
+static bool8 IsGoodSpotForP2(const struct ObjectEvent *p2, s16 x, s16 y, u8 elevation)
+{
+    u8 behavior, tileElevation;
+
+    if (MapGridGetCollisionAt(x, y) || GetMapBorderIdAt(x, y) == CONNECTION_INVALID)
+        return FALSE;
+    tileElevation = MapGridGetElevationAt(x, y);
+    if (tileElevation != 0 && tileElevation != 15 && elevation != 0 && elevation != 15 && tileElevation != elevation)
+        return FALSE;
+    behavior = MapGridGetMetatileBehaviorAt(x, y);
+    if (MetatileBehavior_IsSurfableWaterOrUnderwater(behavior)
+     || MetatileBehavior_IsDoor(behavior)
+     || MetatileBehavior_IsWarpDoor(behavior)
+     || MetatileBehavior_IsNonAnimDoor(behavior)
+     || MetatileBehavior_IsLadder(behavior)
+     || MetatileBehavior_IsEscalator(behavior)
+     || Coop_IsWarpTile(behavior))
+        return FALSE;
+    return !IsAnyObjectAt(p2, x, y);
+}
+
+static void RideAlong(struct ObjectEvent *p2)
+{
+    struct ObjectEvent *p1 = GetPlayer1();
+
+    if (p2->currentCoords.x != p1->currentCoords.x || p2->currentCoords.y != p1->currentCoords.y)
+        MoveObjectEventToMapCoords(p2, p1->currentCoords.x, p1->currentCoords.y);
+    p2->currentElevation = p1->currentElevation;
+    p2->previousElevation = p1->previousElevation;
+    p2->invisible = TRUE;
+}
+
+static u8 OppositeDirection(u8 dir)
+{
+    switch (dir)
+    {
+    case DIR_NORTH: return DIR_SOUTH;
+    case DIR_SOUTH: return DIR_NORTH;
+    case DIR_WEST:  return DIR_EAST;
+    default:        return DIR_WEST;
+    }
+}
+
+// Puts Player 2 on a free tile next to Player 1 (behind first), or keeps them
+// riding along if there's no room.
+static void PlaceP2NearP1(struct ObjectEvent *p2)
+{
+    struct ObjectEvent *p1 = GetPlayer1();
+    u8 facing = p1->facingDirection;
+    u8 dirs[4];
+    s32 i;
+
+    dirs[0] = OppositeDirection(facing);
+    dirs[1] = (facing == DIR_NORTH || facing == DIR_SOUTH) ? DIR_WEST : DIR_NORTH;
+    dirs[2] = OppositeDirection(dirs[1]);
+    dirs[3] = facing;
+
+    for (i = 0; i < 4; i++)
+    {
+        s16 x = p1->currentCoords.x;
+        s16 y = p1->currentCoords.y;
+        MoveCoords(dirs[i], &x, &y);
+        if (IsGoodSpotForP2(p2, x, y, p1->currentElevation))
+        {
+            MoveObjectEventToMapCoords(p2, x, y);
+            ObjectEventUpdateElevation(p2);
+            p2->invisible = FALSE;
+            ObjectEventTurn(p2, facing);
+            return;
+        }
+    }
+    RideAlong(p2);
+}
+
+static void SpawnP2(void)
+{
+    struct ObjectEvent *p1 = GetPlayer1();
+    u8 graphicsId = GetRivalAvatarGraphicsIdByStateIdAndGender(PLAYER_AVATAR_STATE_NORMAL, gSaveBlock2Ptr->playerGender ^ 1);
+    u8 objEventId = SpawnSpecialObjectEventParameterized(graphicsId, MOVEMENT_TYPE_PLAYER, LOCALID_COOP_PLAYER2,
+                                                          p1->currentCoords.x, p1->currentCoords.y, p1->currentElevation);
+
+    if (objEventId < OBJECT_EVENTS_COUNT)
+        RideAlong(&gObjectEvents[objEventId]); // Hops off once Player 1 stands still
+}
+
+// After a warp/map load: Player 2 arrives with Player 1.
+void CoopP2_OnMapLoad(void)
+{
+    if (gCoopLinkActive && CoopP2_GetObject() == NULL)
+        SpawnP2();
+}
+
+// After returning to the field (continue, end of battle, closing a menu).
+void CoopP2_EnsureSpawned(void)
+{
+    if (gCoopLinkActive && CoopP2_GetObject() == NULL)
+        SpawnP2();
+}
+
+static u8 GetDpadDirection(u16 keys)
+{
+    if (keys & DPAD_UP)
+        return DIR_NORTH;
+    if (keys & DPAD_DOWN)
+        return DIR_SOUTH;
+    if (keys & DPAD_LEFT)
+        return DIR_WEST;
+    if (keys & DPAD_RIGHT)
+        return DIR_EAST;
+    return DIR_NONE;
+}
+
+static void SpawnObjectsAroundP2(void)
+{
+    // Objects are positioned relative to the camera, so only do this while the
+    // camera isn't in the middle of scrolling. Player 1's camera movement also
+    // spawns objects around Player 2 (the spawn area covers both players).
+    if (gFieldCamera.x == 0 && gFieldCamera.y == 0)
+    {
+        TrySpawnObjectEvents(0, 0);
+        RemoveObjectEventsOutsideView();
+    }
+}
+
+static bool8 sP2Interacting; // The running script was started by Player 2
+static bool8 sP2Stepped;     // Player 2's current movement is a step (check for warps when it ends)
+
+// Player 2 walks through a door: open it, step in, close it, then both players warp.
+#define tState  data[0]
+#define tDoorTask data[1]
+#define tDoorX  data[2]
+#define tDoorY  data[3]
+
+static void Task_CoopP2DoorWarp(u8 taskId)
+{
+    struct Task *task = &gTasks[taskId];
+    struct ObjectEvent *p2 = CoopP2_GetObject();
+
+    switch (task->tState)
+    {
+    case 0:
+        FreezeObjectEvents();
+        PlaySE(GetDoorSoundEffect(task->tDoorX, task->tDoorY));
+        task->tDoorTask = FieldAnimateDoorOpen(task->tDoorX, task->tDoorY);
+        task->tState++;
+        break;
+    case 1:
+        if (task->tDoorTask < 0 || !gTasks[task->tDoorTask].isActive)
+        {
+            if (p2 != NULL)
+            {
+                ObjectEventClearHeldMovementIfActive(p2);
+                ObjectEventSetHeldMovement(p2, MOVEMENT_ACTION_WALK_NORMAL_UP);
+            }
+            task->tState++;
+        }
+        break;
+    case 2:
+        if (p2 == NULL || ObjectEventClearHeldMovementIfFinished(p2))
+        {
+            if (p2 != NULL)
+                p2->invisible = TRUE;
+            task->tDoorTask = FieldAnimateDoorClose(task->tDoorX, task->tDoorY);
+            task->tState++;
+        }
+        break;
+    case 3:
+        if (task->tDoorTask < 0 || !gTasks[task->tDoorTask].isActive)
+        {
+            DoWarp(); // Fades out and loads the destination with Player 1 at the door
+            DestroyTask(taskId);
+        }
+        break;
+    }
+}
+
+#undef tState
+#undef tDoorTask
+#undef tDoorX
+#undef tDoorY
+
+// Facing direction of the player who started the running script.
+u8 CoopP2_GetInteractingFacing(void)
+{
+    struct ObjectEvent *p2 = CoopP2_GetObject();
+
+    if (sP2Interacting && p2 != NULL)
+        return p2->facingDirection;
+    return GetPlayerFacingDirection();
+}
+
+// Player 2 pressed A: talk to whoever / use whatever is in front of them.
+static bool8 TryP2Interaction(struct ObjectEvent *p2)
+{
+    s16 x = p2->currentCoords.x;
+    s16 y = p2->currentCoords.y;
+    u8 dir = p2->facingDirection;
+
+    MoveCoords(dir, &x, &y);
+    if (!Coop_TryStartInteractionAt(x, y, p2->currentElevation, dir))
+        return FALSE;
+    sP2Interacting = TRUE;
+    gCoopInputOwner = COOP_PLAYER_2; // Player 2 answers this conversation
+    return TRUE;
+}
+
+static void TryStartP2Step(struct ObjectEvent *p2)
+{
+    struct ObjectEvent *p1 = GetPlayer1();
+    u16 keys = CoopLink_GetPlayerKeys(COOP_PLAYER_2);
+    u8 dir = GetDpadDirection(keys);
+    s16 x, y;
+
+    if (dir == DIR_NONE)
+        return;
+
+    // Exit mats and other arrow warps: pushing toward them takes both players out.
+    if (Coop_TryStepWarpAt(p2->currentCoords.x, p2->currentCoords.y, p2->currentElevation, dir, TRUE))
+        return;
+
+    x = p2->currentCoords.x;
+    y = p2->currentCoords.y;
+    MoveCoords(dir, &x, &y);
+
+    // Doors: Player 2 walks in and Player 1 comes along.
+    if (Coop_TrySetupDoorWarpAt(x, y, p2->currentElevation, dir))
+    {
+        u8 taskId = CreateTask(Task_CoopP2DoorWarp, 10);
+        gTasks[taskId].data[2] = x;
+        gTasks[taskId].data[3] = y;
+        LockPlayerFieldControls();
+        gFieldCallback = FieldCB_DefaultWarpExit;
+        return;
+    }
+
+    if (GetLedgeJumpDirection(x, y, dir) != DIR_NONE)
+    {
+        s16 landX = x, landY = y;
+        MoveCoords(dir, &landX, &landY);
+        if (IsWithinTether(landX, landY, p1->currentCoords.x, p1->currentCoords.y) && !IsAnyObjectAt(p2, landX, landY))
+        {
+            ObjectEventSetHeldMovement(p2, GetJump2MovementAction(dir));
+            sP2Stepped = TRUE;
+            SpawnObjectsAroundP2();
+            return;
+        }
+    }
+    else if (GetCollisionAtCoords(p2, x, y, dir) == COLLISION_NONE
+          && IsWithinTether(x, y, p1->currentCoords.x, p1->currentCoords.y)
+          && !MetatileBehavior_IsSurfableWaterOrUnderwater(MapGridGetMetatileBehaviorAt(x, y)))
+    {
+        if ((keys & B_BUTTON) && FlagGet(FLAG_SYS_B_DASH))
+            ObjectEventSetHeldMovement(p2, GetWalkFastMovementAction(dir));
+        else
+            ObjectEventSetHeldMovement(p2, GetWalkNormalMovementAction(dir));
+        sP2Stepped = TRUE;
+        SpawnObjectsAroundP2();
+        return;
+    }
+
+    // Blocked: just turn to face that way.
+    if (p2->facingDirection != dir)
+        ObjectEventSetHeldMovement(p2, GetFaceDirectionMovementAction(dir));
+}
+
+// Runs once per simulated frame in the overworld (CB1_Overworld).
+void CoopP2_Update(void)
+{
+    struct ObjectEvent *p1 = GetPlayer1();
+    struct ObjectEvent *p2;
+
+    if (!gCoopLinkActive)
+        return;
+
+    p2 = CoopP2_GetObject();
+    if (p2 == NULL)
+    {
+        CoopP2_EnsureSpawned();
+        return;
+    }
+
+    if (FuncIsActiveTask(Task_CoopP2DoorWarp))
+        return; // Walking through a door
+
+    if (MustRideAlong())
+    {
+        sP2Stepped = FALSE;
+        RideAlong(p2);
+        return;
+    }
+
+    if (p2->invisible)
+    {
+        sP2Stepped = FALSE;
+        // Riding along: hop off once Player 1 stands still with free controls.
+        if (!ArePlayerFieldControlsLocked() && gPlayerAvatar.tileTransitionState == T_NOT_MOVING)
+            PlaceP2NearP1(p2);
+        else
+            RideAlong(p2);
+        return;
+    }
+
+    // Still in the middle of a step?
+    if (ObjectEventIsHeldMovementActive(p2) && !ObjectEventClearHeldMovementIfFinished(p2))
+        return;
+
+    // Player 1 got moved too far away (cutscene, forced movement...): catch up.
+    if (!IsWithinTether(p2->currentCoords.x, p2->currentCoords.y, p1->currentCoords.x, p1->currentCoords.y))
+    {
+        PlaceP2NearP1(p2);
+        return;
+    }
+
+    if (ArePlayerFieldControlsLocked())
+        return; // Menus and cutscenes: Player 2 waits
+
+    // Just stepped onto stairs, a ladder, a cave entrance...: both players warp.
+    if (sP2Stepped)
+    {
+        sP2Stepped = FALSE;
+        if (Coop_TryStepWarpAt(p2->currentCoords.x, p2->currentCoords.y, p2->currentElevation, p2->facingDirection, FALSE))
+            return;
+    }
+
+    sP2Interacting = FALSE;
+    if ((CoopLink_GetPlayerNewKeys(COOP_PLAYER_2) & A_BUTTON) && TryP2Interaction(p2))
+        return;
+    TryStartP2Step(p2);
+}
