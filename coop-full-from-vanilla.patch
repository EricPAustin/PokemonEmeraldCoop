+
+// Linked co-op: Player 2 walks into a door at (x, y) (facing north). Sets up
+// the warp so both players go through; the caller animates the door.
+bool8 Coop_TrySetupDoorWarpAt(s16 x, s16 y, u8 elevation, u8 direction)
+{
+    struct MapPosition position;
+    u8 metatileBehavior = MapGridGetMetatileBehaviorAt(x, y);
+    s8 warpEventId;
+
+    if (direction != DIR_NORTH || !MetatileBehavior_IsWarpDoor(metatileBehavior))
+        return FALSE;
+    position.x = x;
+    position.y = y;
+    position.elevation = elevation;
+    warpEventId = GetWarpEventAtMapPosition(&gMapHeader, &position);
+    if (warpEventId == WARP_ID_NONE)
+        return FALSE;
+    StoreInitialPlayerAvatarState();
+    SetupWarp(&gMapHeader, warpEventId, &position);
+    return TRUE;
+}
+
+// Linked co-op: Player 2 is standing on (x, y). With arrow = TRUE, Player 2 is
+// pushing toward an arrow warp (exit mats); otherwise Player 2 just stepped onto
+// a warp tile (stairs, ladders, cave entrances...). Both players warp.
+bool8 Coop_TryStepWarpAt(s16 x, s16 y, u8 elevation, u8 direction, bool8 arrow)
+{
+    struct MapPosition position;
+    u8 metatileBehavior = MapGridGetMetatileBehaviorAt(x, y);
+    s8 warpEventId;
+
+    if (arrow)
+    {
+        if (!IsArrowWarpMetatileBehavior(metatileBehavior, direction))
+            return FALSE;
+    }
+    else
+    {
+        if (!IsWarpMetatileBehavior(metatileBehavior)
+         || MetatileBehavior_IsMtPyreHole(metatileBehavior)
+         || MetatileBehavior_IsUnionRoomWarp(metatileBehavior))
+            return FALSE;
+    }
