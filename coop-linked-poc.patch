diff --git a/src/coop_link.c b/src/coop_link.c
new file mode 100644
index 0000000..59aab29
--- /dev/null
+++ b/src/coop_link.c
@@ -0,0 +1,222 @@
+#include "global.h"
+#include "coop_link.h"
+#include "event_data.h"
+#include "event_object_movement.h"
+#include "field_message_box.h"
+#include "field_player_avatar.h"
+#include "field_weather.h"
+#include "fieldmap.h"
+#include "link.h"
+#include "main.h"
+#include "overworld.h"
+#include "palette.h"
+#include "script.h"
+#include "sound.h"
+#include "task.h"
+#include "constants/maps.h"
+#include "constants/songs.h"
+#include "constants/field_weather.h"
+
+#define LINKTYPE_COOP 0x7711
+
+// Where both players appear once linked (Route 101, next to each other).
+#define COOP_LINK_MAP  MAP_ROUTE101
+#define COOP_LINK_X    10
+#define COOP_LINK_Y    10
+
+EWRAM_DATA bool8 gCoopLinkActive = FALSE;
+
+static const u8 sText_CoopLinkWaiting[] = _("Co-op link: waiting for\nthe other player…");
+static const u8 sText_CoopLinkFailed[] = _("Co-op link failed.");
+
+enum {
+    STATE_OPEN,
+    STATE_WAIT_PLAYERS,
+    STATE_CONFIRM,
+    STATE_EXCHANGE,
+    STATE_FADE,
+    STATE_WARP,
+    STATE_FAILED,
+    STATE_FAILED_WAIT,
+};
+
+#define tState data[0]
+#define tTimer data[1]
+
+static void Task_CoopLinkup(u8 taskId)
+{
+    struct Task *task = &gTasks[taskId];
+
+    if (task->tState != STATE_FAILED && task->tState != STATE_FAILED_WAIT
+     && task->tState >= STATE_WAIT_PLAYERS && HasLinkErrorOccurred())
+        task->tState = STATE_FAILED;
+
+    switch (task->tState)
+    {
+    case STATE_OPEN:
+        gLinkType = LINKTYPE_COOP;
+        OpenLinkTimed();
+        ResetLinkPlayerCount();
+        ResetLinkPlayers();
+        ShowFieldAutoScrollMessage(sText_CoopLinkWaiting);
+        task->tTimer = 0;
+        task->tState++;
+        break;
+    case STATE_WAIT_PLAYERS:
+        if (++task->tTimer < 10)
+            break;
+        if (GetLinkPlayerCount_2() >= 2)
+        {
+            task->tTimer = 0;
+            task->tState++;
+        }
+        break;
+    case STATE_CONFIRM:
+        // Give the link a moment to settle, then the master confirms for everyone.
+        if (++task->tTimer < 30)
+            break;
+        if (IsLinkMaster())
+        {
+            SaveLinkPlayers(GetLinkPlayerCount_2());
+            CheckShouldAdvanceLinkState();
+        }
+        task->tState++;
+        break;
+    case STATE_EXCHANGE:
+        switch (GetLinkPlayerDataExchangeStatusTimed(2, 2))
+        {
+        case EXCHANGE_COMPLETE:
+            gFieldLinkPlayerCount = GetLinkPlayerCount_2();
+            gLocalLinkPlayerId = GetMultiplayerId();
+            SaveLinkPlayers(gFieldLinkPlayerCount);
+            gCoopLinkActive = TRUE;
+            HideFieldMessageBox();
+            FadeScreen(FADE_TO_BLACK, 0);
+            task->tState = STATE_FADE;
+            break;
+        case EXCHANGE_DIFF_SELECTIONS:
+        case EXCHANGE_PLAYER_NOT_READY:
+        case EXCHANGE_PARTNER_NOT_READY:
+        case EXCHANGE_WRONG_NUM_PLAYERS:
+            task->tState = STATE_FAILED;
+            break;
+        }
+        break;
+    case STATE_FADE:
+        if (!gPaletteFade.active)
+            task->tState++;
+        break;
+    case STATE_WARP:
+        SetWarpDestination(MAP_GROUP(COOP_LINK_MAP), MAP_NUM(COOP_LINK_MAP), WARP_ID_NONE, COOP_LINK_X, COOP_LINK_Y);
+        WarpIntoMap();
+        SetMainCallback2(CB2_ReturnToFieldCableClub);
+        DestroyTask(taskId);
+        break;
+    case STATE_FAILED:
+        CloseLink();
+        gCoopLinkActive = FALSE;
+        ShowFieldAutoScrollMessage(sText_CoopLinkFailed);
+        task->tTimer = 0;
+        task->tState++;
+        break;
+    case STATE_FAILED_WAIT:
+        if (++task->tTimer > 120)
+        {
+            HideFieldMessageBox();
+            UnlockPlayerFieldControls();
+            DestroyTask(taskId);
+        }
+        break;
+    }
+}
+
+#undef tState
+#undef tTimer
+
+void CoopLink_Start(void)
+{
+    if (FuncIsActiveTask(Task_CoopLinkup))
+        return;
+    LockPlayerFieldControls();
+    FreezeObjectEvents();
+    PlaySE(SE_PIN);
+    CreateTask(Task_CoopLinkup, 80);
+}
+
+static bool8 IsCoordOutsideMap(s16 x, s16 y)
+{
+    return x < MAP_OFFSET || y < MAP_OFFSET
+        || x >= MAP_OFFSET + gMapHeader.mapLayout->width
+        || y >= MAP_OFFSET + gMapHeader.mapLayout->height;
+}
+
+static bool8 IsOtherLinkPlayerObj(u8 objEventId, u8 selfObjEventId)
+{
+    s32 i;
+    for (i = 0; i < MAX_LINK_PLAYERS; i++)
+    {
+        if (gLinkPlayerObjectEvents[i].active
+         && gLinkPlayerObjectEvents[i].objEventId == objEventId
+         && objEventId != selfObjEventId)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// Collision for linked co-op. Both games must reach exactly the same answer, so
+// this only looks at data that is identical on both sides: the map, the other
+// linked players and the map's NPC templates (NPCs are frozen in place, and
+// which NPC sprites exist depends on each player's camera).
+bool8 CoopLink_GetCollision(u8 selfObjEventId, s16 x, s16 y)
+{
+    s32 i;
+
+    if (IsCoordOutsideMap(x, y))
+        return TRUE;
+
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        struct ObjectEvent *obj = &gObjectEvents[i];
+        if (!obj->active || !IsOtherLinkPlayerObj(i, selfObjEventId))
+            continue;
+        if ((obj->currentCoords.x == x && obj->currentCoords.y == y)
+         || (obj->previousCoords.x == x && obj->previousCoords.y == y))
+            return TRUE;
+        // Tether: never move further than this from the other player.
+        if (x - obj->currentCoords.x > COOP_TETHER_X || obj->currentCoords.x - x > COOP_TETHER_X
+         || y - obj->currentCoords.y > COOP_TETHER_Y || obj->currentCoords.y - y > COOP_TETHER_Y)
+            return TRUE;
+    }
+
+    for (i = 0; i < gMapHeader.events->objectEventCount && i < OBJECT_EVENT_TEMPLATES_COUNT; i++)
+    {
+        const struct ObjectEventTemplate *template = &gSaveBlock1Ptr->objectEventTemplates[i];
+        if (template->flagId != 0 && FlagGet(template->flagId))
+            continue;
+        if (template->x + MAP_OFFSET == x && template->y + MAP_OFFSET == y)
+            return TRUE;
+    }
+
+    return MapGridGetCollisionAt(x, y);
+}
+
+// NPCs stay where the map places them, so every game agrees on where they are.
+void CoopLink_FreezeNPCs(void)
+{
+    s32 i, j;
+
+    for (i = 0; i < OBJECT_EVENTS_COUNT; i++)
+    {
+        bool8 isLinkPlayer = FALSE;
+
+        if (!gObjectEvents[i].active || gObjectEvents[i].frozen)
+            continue;
+        for (j = 0; j < MAX_LINK_PLAYERS; j++)
+        {
+            if (gLinkPlayerObjectEvents[j].active && gLinkPlayerObjectEvents[j].objEventId == i)
+                isLinkPlayer = TRUE;
+        }
+        if (!isLinkPlayer)
+            FreezeObjectEvent(&gObjectEvents[i]);
+    }
+}
